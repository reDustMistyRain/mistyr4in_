#!/bin/bash
# 取得目前腳本所在目錄並切換進去
cd "$(dirname "$0")"

echo "================================================="
echo "  🚀 正在啟動 mistyr4in_ 部落格 - 本地私密預覽伺服器"
echo "================================================="
echo "  📌 網址: http://127.0.0.1:8000"
echo "  🔒 狀態: 僅限本機預覽 (對外未公開，外界無法連線)"
echo "  💡 提示: 只要此終端機視窗保持開啟，即可隨時瀏覽"
echo "  ⏹️ 停止: 欲關閉伺服器，請在終端機按下 Ctrl + C"
echo "================================================="
echo ""

# 於背景執行：等待 1.5 秒後，自動使用 macOS 預設瀏覽器開啟本地網址
(sleep 1.5 && open "http://127.0.0.1:8000") &

# 啟動 Python 3 內建 HTTP 伺服器，並嚴格綁定於 127.0.0.1 (Loopback) 確保完全私密
python3 -m http.server 8000 --bind 127.0.0.1
